# ============================================================
# LealCert — Variáveis de Ambiente (copie para .env e preencha)
# ============================================================

# ── Banco de Dados ───────────────────────────────────────────
# Senha do PostgreSQL (usada pelo Docker Compose)
DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# ── Segurança ────────────────────────────────────────────────
# Segredo da sessão — OBRIGATÓRIO em produção
# Gere com: openssl rand -hex 32
SESSION_SECRET=TROQUE_POR_UMA_STRING_ALEATORIA_DE_64_CARACTERES

# ── CORS — domínio do seu servidor ───────────────────────────
# URL completa do seu site (com https://)
# Múltiplos domínios: separe por vírgula
ALLOWED_ORIGINS=https://lealcert.seudominio.com.br

# ── E-mail SMTP (opcional — pode configurar no painel admin) ─
# SMTP_HOST=smtp.seudominio.com.br
# SMTP_PORT=587
# SMTP_USER=naoresponda@seudominio.com.br
# SMTP_PASS=senha_smtp
# SMTP_FROM=LealCert <naoresponda@seudominio.com.br>
