# ── Docker Hub ─────────────────────────────────────────────────────────────
# Seu usuário no Docker Hub (ex: joaosilva)
DOCKER_HUB_USER=seu_usuario_dockerhub

# ── VPS / SSH ──────────────────────────────────────────────────────────────
# IP ou hostname do seu servidor
VPS_HOST=123.456.789.000
# Usuário SSH (geralmente root ou ubuntu)
VPS_USER=root

# ── Banco de dados ─────────────────────────────────────────────────────────
DB_USER=lealcert
# Senha forte — gere com: openssl rand -hex 32
DB_PASSWORD=troque_por_senha_forte

# ── Sessão (Express) ───────────────────────────────────────────────────────
# Chave secreta — gere com: openssl rand -hex 32
SESSION_SECRET=troque_por_chave_secreta_forte

# ── E-mail SMTP (opcional) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=senha_app_google
SMTP_FROM=LealCert <seu@email.com>

# ── Coolify (opcional — para redeploy automático) ──────────────────────────
# URL do webhook de cada serviço no painel Coolify
COOLIFY_WEBHOOK_API=https://seu-coolify.com/api/v1/deploy?uuid=XXX&token=YYY
COOLIFY_WEBHOOK_WEB=https://seu-coolify.com/api/v1/deploy?uuid=ZZZ&token=YYY

# ── Tag da imagem Docker ───────────────────────────────────────────────────
TAG=latest
