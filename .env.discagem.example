# ─── Sistema de Discagem Automática com IA ───────────────────────
# Copie este arquivo para .env e preencha os valores.

# ── Twilio ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+5511000000000

# ── IA — escolha um ou ambos ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# ── TTS — escolha um ou ambos ────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_key
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

ELEVENLABS_API_KEY=your_elevenlabs_key
# Voice ID padrão: Rachel (multilíngue). Troque pelo seu voice clone se quiser.
# Encontre IDs em: https://api.elevenlabs.io/v1/voices

# ── STT ─────────────────────────────────────────────────────────
# Deepgram é usado para transcrição pós-chamada de alta qualidade.
# Para STT em tempo real na conversa, Twilio usa speech recognition nativo.
DEEPGRAM_API_KEY=your_deepgram_key

# ── Banco de dados ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:senha@localhost:5432/lealcert

# ── URL pública da aplicação (OBRIGATÓRIA para webhooks Twilio) ──
# Twilio precisa conseguir chamar este endereço.
# Em desenvolvimento, use ngrok: https://xxxxx.ngrok.io
# Em produção: https://meusite.com.br
PUBLIC_HOSTNAME=https://meusite.com.br

# ── Outros ───────────────────────────────────────────────────────
SESSION_SECRET=troca_por_uma_string_longa_e_aleatoria
PORT=8080
NODE_ENV=production
